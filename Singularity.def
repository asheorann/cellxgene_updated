Bootstrap: docker
From: continuumio/miniconda3:latest

%labels
    Author Anushka
    Version 1.5
    Description CellxGene VIP with Cell-Cell Communication (CCC) analysis and modern UI
    Institution Penn Vet
    BuildDate 2026-11

%help
    CellxGene VIP Container for Single-Cell RNA-seq Visualization
    ==============================================================

    This container provides CellxGene with the VIP (Visualization in Plugin)
    extension, including Cell-Cell Communication analysis via LIANA.

    USAGE:
      singularity run cellxgene_vip.sif /path/to/data.h5ad
      singularity run cellxgene_vip.sif /path/to/data.h5ad 5006
      singularity run --bind /your/data:/data cellxgene_vip.sif /data/file.h5ad

%environment
    export PATH=/opt/conda/envs/VIP/bin:$PATH
    export CONDA_DEFAULT_ENV=VIP
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export R_LIBS_USER=/opt/conda/envs/VIP/lib/R/library

%files
    cellxgene_VIP /opt/cellxgene_VIP

%post
    # Update system and install dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libhdf5-dev \
        libffi-dev \
        libssl-dev \
        libcurl4-openssl-dev \
        libxml2-dev \
        libpng-dev \
        libjpeg-dev \
        libcairo2-dev \
        libxt-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libtiff5-dev \
        libgit2-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        r-base \
        r-base-dev \
        curl \
        wget \
        git \
        && rm -rf /var/lib/apt/lists/*

    # Initialize conda
    . /opt/conda/etc/profile.d/conda.sh

    # Create VIP environment with Python 3.8 (better compatibility with cellxgene)
    conda create -n VIP python=3.8 -y
    conda activate VIP

    # Install cellxgene dependencies first (with compatible versions)
    pip install --no-cache-dir \
        'anndata>=0.7.6,<0.10' \
        'numpy>=1.17.5,<1.24' \
        'pandas>=1.0,<2.0' \
        'scipy>=1.4' \
        'h5py>=3.0.0' \
        'numba>=0.51.2'

    # Install Flask and extensions (Flask <2.2 for JSONEncoder compatibility)
    pip install --no-cache-dir \
        'Flask>=1.0.2,<2.2.0' \
        'werkzeug<2.3.0' \
        'Flask-Compress>=1.4.0' \
        'Flask-Cors>=3.0.9' \
        'Flask-RESTful>=0.3.6' \
        'flask-server-timing>=0.1.2' \
        'flask-talisman>=0.7.0'

    # Install other cellxgene requirements
    pip install --no-cache-dir \
        'boto3>=1.12.18' \
        'click>=7.1.2' \
        'flatbuffers>=1.11.0,<2.0.0' \
        'flatten-dict>=0.2.0' \
        'fsspec>=0.4.4,<2022.0.0' \
        'gunicorn>=20.0.4' \
        'packaging>=20.0' \
        'PyYAML>=5.4' \
        'requests>=2.22.0' \
        's3fs>=0.4.2,<2022.0.0'

    # Install cellxgene from the VIP-modified source
    cd /opt/cellxgene_VIP/cellxgene
    pip install --no-cache-dir .

    # Get the site-packages path
    SITE_PACKAGES=$(python -c 'import site; print(site.getsitepackages()[0])')
    echo "Site packages: $SITE_PACKAGES"

    # Create the web static and templates directory structure that VIP expects
    mkdir -p "$SITE_PACKAGES/server/common/web/static"
    mkdir -p "$SITE_PACKAGES/server/common/web/templates"
    mkdir -p "$SITE_PACKAGES/server/app"

    # Copy static files from client build to the expected location
    if [ -d "/opt/cellxgene_VIP/cellxgene/client/build/static" ]; then
        cp -r /opt/cellxgene_VIP/cellxgene/client/build/static/* "$SITE_PACKAGES/server/common/web/static/"
    fi

    # Also check the build directory for static files
    if [ -d "/opt/cellxgene_VIP/cellxgene/build/client/static" ]; then
        cp -r /opt/cellxgene_VIP/cellxgene/build/client/static/* "$SITE_PACKAGES/server/common/web/static/"
    fi

    # Copy index.html to templates directory (Flask looks for it there)
    if [ -f "/opt/cellxgene_VIP/cellxgene/build/server/common/web/templates/index.html" ]; then
        cp /opt/cellxgene_VIP/cellxgene/build/server/common/web/templates/index.html "$SITE_PACKAGES/server/common/web/templates/"
    elif [ -f "/opt/cellxgene_VIP/cellxgene/client/build/index.html" ]; then
        cp /opt/cellxgene_VIP/cellxgene/client/build/index.html "$SITE_PACKAGES/server/common/web/templates/"
    fi

    # Copy server files from build directory (has the complete structure)
    if [ -d "/opt/cellxgene_VIP/cellxgene/build/server" ]; then
        cp -r /opt/cellxgene_VIP/cellxgene/build/server/* "$SITE_PACKAGES/server/" 2>/dev/null || true
    fi

    # Copy server source files
    if [ -d "/opt/cellxgene_VIP/cellxgene/server" ]; then
        cp -r /opt/cellxgene_VIP/cellxgene/server/* "$SITE_PACKAGES/server/" 2>/dev/null || true
    fi

    echo "Static files copied to: $SITE_PACKAGES/server/common/web/static/"
    ls -la "$SITE_PACKAGES/server/common/web/static/" || echo "Warning: static dir may be empty"

    # Install scanpy and visualization packages
    pip install --no-cache-dir \
        'scanpy>=1.7.0,<1.10' \
        'matplotlib>=3.3.0,<3.8' \
        'seaborn>=0.11.0' \
        'plotly>=4.8.0' \
        'kaleido'

    # Install diffxpy for differential expression (required by VIPInterface)
    pip install --no-cache-dir 'diffxpy>=0.7.4'

    # Install LIANA for Cell-Cell Communication
    pip install --no-cache-dir \
        'liana>=0.1.9' \
        'plotnine>=0.10.0'

    # Install additional Python dependencies
    pip install --no-cache-dir \
        'xlsxwriter' \
        'openpyxl' \
        'umap-learn>=0.4.0' \
        'pyarrow>=1.0.0,<12.0.0' \
        'tables>=3.6.0' \
        'numexpr>=2.7.0' \
        'scikit-learn>=0.24.0'

    # Install R packages for VIP visualizations
    echo "Installing R packages..."

    # Install from CRAN (comprehensive list)
    R -e "options(repos = c(CRAN = 'https://cloud.r-project.org/')); \
          install.packages(c( \
            'ggplot2', \
            'dplyr', \
            'tidyr', \
            'tidyverse', \
            'pheatmap', \
            'circlize', \
            'RColorBrewer', \
            'viridis', \
            'gridExtra', \
            'cowplot', \
            'ggrepel', \
            'reshape2', \
            'optparse', \
            'data.table', \
            'png', \
            'glue', \
            'ggpubr', \
            'ggrastr', \
            'MASS', \
            'ggforce', \
            'patchwork' \
          ), quiet = TRUE)"

    # Install Bioconductor packages
    R -e "if (!require('BiocManager', quietly = TRUE)) { \
            install.packages('BiocManager', repos = 'https://cloud.r-project.org/') \
          }; \
          BiocManager::install(c('ComplexHeatmap', 'fgsea', 'rtracklayer'), ask = FALSE, update = FALSE)"

    # ============================================
    # VIP SETUP - Copy all VIP files to static
    # ============================================

    # Copy VIP static assets to cellxgene static folder
    cp /opt/cellxgene_VIP/jquery.min.js "$SITE_PACKAGES/server/common/web/static/"
    cp /opt/cellxgene_VIP/jquery-ui.min.js "$SITE_PACKAGES/server/common/web/static/"
    cp /opt/cellxgene_VIP/saveVIP.js "$SITE_PACKAGES/server/common/web/static/"
    cp /opt/cellxgene_VIP/interface.html "$SITE_PACKAGES/server/common/web/static/"
    cp /opt/cellxgene_VIP/ccc.js "$SITE_PACKAGES/server/common/web/static/"
    cp /opt/cellxgene_VIP/ccc.html "$SITE_PACKAGES/server/common/web/static/"
    cp /opt/cellxgene_VIP/vip-theme.js "$SITE_PACKAGES/server/common/web/static/"
    cp /opt/cellxgene_VIP/vip-theme.css "$SITE_PACKAGES/server/common/web/static/"

    # Copy VIP directories
    cp -r /opt/cellxgene_VIP/jspanel "$SITE_PACKAGES/server/common/web/static/"
    cp -r /opt/cellxgene_VIP/stackedbar "$SITE_PACKAGES/server/common/web/static/"
    cp -r /opt/cellxgene_VIP/d3plot "$SITE_PACKAGES/server/common/web/static/"
    cp -r /opt/cellxgene_VIP/DataTables "$SITE_PACKAGES/server/common/web/static/"
    cp -r /opt/cellxgene_VIP/gsea "$SITE_PACKAGES/server/common/web/static/" 2>/dev/null || true
    cp -r /opt/cellxgene_VIP/ace "$SITE_PACKAGES/server/common/web/static/" 2>/dev/null || true

    # Download d3.v4 locally (needed for VIP)
    curl -s -o "$SITE_PACKAGES/server/common/web/static/d3.v4.min.js" https://d3js.org/d3.v4.min.js

    # Copy VIP Python files
    cp /opt/cellxgene_VIP/VIPInterface.py "$SITE_PACKAGES/server/app/"
    cp /opt/cellxgene_VIP/ccc.py "$SITE_PACKAGES/server/app/"

    # Copy R scripts
    cp /opt/cellxgene_VIP/*.R "$SITE_PACKAGES/server/app/" 2>/dev/null || true
    cp /opt/cellxgene_VIP/*.csv "$SITE_PACKAGES/server/app/" 2>/dev/null || true

    # Make R scripts executable
    chmod +x "$SITE_PACKAGES/server/app/"*.R 2>/dev/null || true
    chmod +x /opt/cellxgene_VIP/*.R 2>/dev/null || true
    chmod +x /opt/cellxgene_VIP/bin/*.R 2>/dev/null || true

    # ============================================
    # FIX VIP TEMPLATE - Inject VIP into index.html
    # ============================================

    # Create modified index_template.insert with local paths (not CDN)
    cp /opt/cellxgene_VIP/index_template.insert /tmp/vip_insert.html
    sed -i 's|https://interactivereport.github.io/cellxgene_VIP/static/|static/|g' /tmp/vip_insert.html
    sed -i 's|https://d3js.org/d3.v4.min.js|static/d3.v4.min.js|g' /tmp/vip_insert.html
    sed -i 's|https://bxaf.net/genesets/|static/gsea/|g' /tmp/vip_insert.html

    # Inject VIP code into index.html template (before </body>)
    sed -i 's|</body></html>||g' "$SITE_PACKAGES/server/common/web/templates/index.html"
    cat /tmp/vip_insert.html >> "$SITE_PACKAGES/server/common/web/templates/index.html"
    echo "</body></html>" >> "$SITE_PACKAGES/server/common/web/templates/index.html"

    # ============================================
    # VERIFY VIP INSTALLATION
    # ============================================

    echo "=== Verifying VIP installation ==="

    # Check VIP static files
    echo "VIP static files:"
    ls -la "$SITE_PACKAGES/server/common/web/static/" | head -20

    # Verify critical Python files exist
    echo ""
    echo "Checking VIP Python files:"
    for f in VIPInterface.py ccc.py; do
        if [ -f "$SITE_PACKAGES/server/app/$f" ]; then
            echo "  OK: $f exists"
        else
            echo "  ERROR: $f NOT FOUND!"
            exit 1
        fi
    done

    # Verify VIP route is in app.py
    echo ""
    echo "Checking VIP route in app.py:"
    if grep -q '@webbp.route("/VIP"' "$SITE_PACKAGES/server/app/app.py"; then
        echo "  OK: VIP route found in app.py"
        grep -n "VIP" "$SITE_PACKAGES/server/app/app.py"
    else
        echo "  ERROR: VIP route NOT FOUND in app.py!"
        exit 1
    fi

    # Test Python imports
    echo ""
    echo "Testing Python imports:"
    python -c "
import sys
sys.path.insert(0, '$SITE_PACKAGES')
try:
    from server.app import VIPInterface
    print('  OK: VIPInterface imported successfully')
except Exception as e:
    print(f'  ERROR importing VIPInterface: {e}')
    sys.exit(1)

try:
    import server.app.ccc as ccc
    print('  OK: ccc imported successfully')
except Exception as e:
    print(f'  ERROR importing ccc: {e}')
    sys.exit(1)

try:
    from server.app.app import webbp
    print('  OK: webbp blueprint imported')
except Exception as e:
    print(f'  ERROR importing app: {e}')
    sys.exit(1)

print('  All imports successful!')
"

    echo ""
    echo "=== VIP verification complete ==="

    # Clean up to reduce image size
    conda clean -afy
    pip cache purge
    rm -rf /root/.cache

    echo "VIP installation complete!"

%runscript
    #!/bin/bash
    . /opt/conda/etc/profile.d/conda.sh
    conda activate VIP

    PORT="${PORT:-5005}"
    HOST="${HOST:-0.0.0.0}"

    if [ -z "$1" ]; then
        echo "============================================"
        echo "  CellxGene VIP Container v1.5"
        echo "============================================"
        echo ""
        echo "Usage: singularity run cellxgene_vip.sif /path/to/data.h5ad [port]"
        echo ""
        exit 0
    fi

    DATA_FILE="$1"
    if [ -n "$2" ]; then
        PORT="$2"
    fi

    if [ ! -f "$DATA_FILE" ]; then
        echo "ERROR: Data file not found: $DATA_FILE"
        echo "Use --bind to mount your data directory"
        exit 1
    fi

    echo "============================================"
    echo "  CellxGene VIP"
    echo "============================================"
    echo "  Data: $DATA_FILE"
    echo "  Port: $PORT"
    echo "  URL:  http://localhost:$PORT"
    echo "============================================"
    echo ""

    exec cellxgene launch "$DATA_FILE" --host "$HOST" --port "$PORT"

%test
    echo "Testing CellxGene VIP installation..."

    . /opt/conda/etc/profile.d/conda.sh
    conda activate VIP

    # Test Python packages
    python -c "import scanpy; print(f'scanpy: {scanpy.__version__}')"
    python -c "import anndata; print(f'anndata: {anndata.__version__}')"
    python -c "import liana; print(f'liana: {liana.__version__}')"
    python -c "import pandas; print(f'pandas: {pandas.__version__}')"
    python -c "import numpy; print(f'numpy: {numpy.__version__}')"
    python -c "import diffxpy; print('diffxpy: OK')"
    python -c "import flask; print(f'flask: {flask.__version__}')"

    # Test VIP modules
    echo "Testing VIP modules..."
    python -c "from server.app import VIPInterface; print('VIPInterface: OK')"
    python -c "import server.app.ccc as ccc; print('ccc module: OK')"
    python -c "from server.app.app import webbp; print('Flask webbp blueprint: OK')"

    # Test that VIP route is registered
    python -c "
from server.app.app import webbp
routes = [r.rule for r in webbp.url_map.iter_rules() if hasattr(webbp, 'url_map')]
if not routes:
    # Blueprint hasn't been registered yet, just check the function exists
    from server.app.app import VIP
    print('VIP route function: OK')
else:
    print('VIP routes:', routes)
"

    # Test cellxgene
    cellxgene --version

    # Test R packages
    R -e "library(ComplexHeatmap); library(fgsea); library(ggplot2); cat('R packages OK\n')"

    echo "All tests passed!"
